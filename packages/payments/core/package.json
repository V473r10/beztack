{
  "name": "@beztack/payments",
  "version": "0.0.1",
  "description": "Provider-agnostic payment abstraction for Beztack",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "better-auth": "~1.7.19",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@beztack/mercadopago": "workspace:*",
    "@beztack/payments-polar": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "better-auth": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@beztack/mercadopago": {
      "optional": true
    },
    "@beztack/payments-polar": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  }
}
