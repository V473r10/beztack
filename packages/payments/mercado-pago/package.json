{
  "name": "@beztack/mercadopago",
  "version": "0.0.1",
  "description": "Mercado Pago SDK for Beztack - Server and React integrations",
  "keywords": [
    "checkout",
    "mercadopago",
    "payments",
    "react",
    "sdk",
    "subscriptions"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beztack/payments": "workspace:*",
    "@mercadopago/sdk-react": "^1.0.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.12.1"
}
