{
  "name": "@beztack/payments-polar",
  "version": "0.0.1",
  "description": "Polar payment provider adapter for Beztack",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth-plugin.d.ts",
      "default": "./dist/auth-plugin.js"
    },
    "./auth-client": {
      "types": "./dist/react/auth-plugin.d.ts",
      "default": "./dist/react/auth-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beztack/payments": "workspace:*",
    "@polar-sh/better-auth": "~2.1.4",
    "@polar-sh/sdk": "~1.0.2"
  },
  "devDependencies": {
    "better-auth": "~1.7.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "better-auth": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    }
  }
}
