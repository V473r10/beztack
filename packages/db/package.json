{
  "name": "@beztack/db",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./drizzle-config": {
      "types": "./drizzle.config.ts",
      "import": "./drizzle.config.ts"
    }
  },
  "scripts": {
    "db:generate": "pnpm exec drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "pnpm exec drizzle-kit migrate --config=./drizzle.config.ts",
    "db:push": "pnpm exec drizzle-kit push --config=./drizzle.config.ts",
    "db:studio": "pnpm exec drizzle-kit studio --config=./drizzle.config.ts",
    "generate-auth-schema": "pnpm dlx @better-auth/cli generate --output ./src/auth-schema.generated.ts --config ../../apps/api/server/utils/auth.ts -y",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beztack/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
