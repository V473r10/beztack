{
  "name": "@beztack/env",
  "version": "0.1.0",
  "description": "Centralized T3 Env configuration for Beztack monorepo",
  "keywords": [
    "env",
    "environment",
    "monorepo",
    "t3",
    "validation"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "default": "./dist/nextjs.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "@t3-oss/env-nextjs": "^0.13.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "packageManager": "pnpm@10.12.1"
}
