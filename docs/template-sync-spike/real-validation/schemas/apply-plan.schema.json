{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beztack.dev/schemas/apply-plan.schema.json",
  "title": "Beztack Apply plan",
  "description": "Schema-versioned plan produced by the Sync engine for a Template update. Apply must prepare a reviewable branch or PR-ready state and never mutate main directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "derivedProjectId",
    "templateId",
    "fromRevision",
    "toRevision",
    "branch",
    "summary",
    "updates",
    "skipped",
    "conflicts",
    "migrations",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "derivedProjectId": { "type": "string" },
    "templateId": { "type": "string" },
    "fromRevision": { "type": "string" },
    "toRevision": { "type": "string" },
    "syncEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "branch": {
      "type": "string",
      "description": "Branch the engine would create for PR-only application."
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary intended for the PR description."
    },
    "updates": {
      "type": "array",
      "description": "Files the engine would update.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "reason"],
        "properties": {
          "path": { "type": "string" },
          "ownership": {
            "type": "string",
            "enum": ["template-owned", "custom-owned", "mixed"]
          },
          "reason": { "type": "string" },
          "seam": { "type": ["string", "null"] }
        }
      }
    },
    "skipped": {
      "type": "array",
      "description": "Files the engine would intentionally skip.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "reason"],
        "properties": {
          "path": { "type": "string" },
          "ownership": {
            "type": "string",
            "enum": ["template-owned", "custom-owned", "mixed"]
          },
          "reason": {
            "type": "string",
            "enum": [
              "custom-owned-preserved",
              "template-and-project-changed",
              "ownership-ambiguous",
              "template-owned-preserved-addition"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "ownership": {
            "type": "string",
            "enum": ["template-owned", "custom-owned", "mixed"]
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation of the conflict and resolution options."
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "description": "Template migrations declared by the candidate Template version. The engine surfaces each migration with its idempotency status against the current Derived project; it never executes migrations.",
      "items": { "$ref": "#/$defs/migrationPlan" }
    },
    "blockers": {
      "type": "array",
      "description": "Conditions that prevent apply. Empty list means apply may proceed on a branch.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ownership-overlap",
              "ownership-shadow",
              "engine-incompatible",
              "missing-baseline"
            ]
          },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "description",
        "idempotency",
        "idempotencyStatus",
        "interactive",
        "destructive",
        "trustClass",
        "execution",
        "applyOnBranch"
      ],
      "properties": {
        "id": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["automatic", "manual"]
        },
        "description": { "type": "string" },
        "idempotency": {
          "type": "object",
          "description": "Idempotency check declared by the Template manifest. Mirrored onto the apply plan so MIGRATIONS.md on the branch can render it without re-reading the Template source.",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["file-exists", "marker-present", "command-succeeds"]
            },
            "path": { "type": "string" },
            "marker": { "type": "string" },
            "command": { "type": "string" }
          }
        },
        "idempotencyStatus": {
          "type": "string",
          "enum": ["pending", "already-applied"]
        },
        "interactive": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "trustClass": {
          "type": "string",
          "enum": ["any", "trusted"]
        },
        "execution": {
          "type": "string",
          "enum": ["engine-surfaces-only", "manual-execution-required"]
        },
        "applyOnBranch": {
          "type": "boolean",
          "description": "False when the engine will not even record the migration on the apply branch (e.g. it requires explicit out-of-band execution). True when the engine lists the migration on the apply branch's MIGRATIONS.md so reviewers can act."
        },
        "dryRunCommand": {
          "type": ["string", "null"],
          "description": "Optional dry-run command surfaced for human preview."
        },
        "applyCommand": {
          "type": ["string", "null"],
          "description": "Optional apply command. The engine never runs it."
        },
        "branchAction": {
          "type": "string",
          "description": "What the human reviewer must do with this migration on the apply branch (e.g. 'manually run the apply command after merging')."
        },
        "note": { "type": "string" }
      }
    }
  }
}
