AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=sa-east-1
VITE_API_URL=http://localhost:3000

# Product name shown on the sign-in and sign-up pages.
VITE_APP_NAME=beztack

# Payment Provider (polar or mercadopago)
VITE_PAYMENT_PROVIDER=polar

# Mercado Pago (only required if VITE_PAYMENT_PROVIDER=mercadopago)
VITE_MERCADO_PAGO_PUBLIC_KEY=TEST-***********************

# Project regional defaults (required, no code default).
# The `create` CLI asks for these and writes them here.
# VITE_DEFAULT_CURRENCY: ISO 4217 code (e.g. USD). VITE_DEFAULT_LOCALE: BCP 47 tag (e.g. en-US).
VITE_DEFAULT_CURRENCY=
VITE_DEFAULT_LOCALE=

# Optional docs URL for the sidebar "Get Help" link. The link is hidden when unset.
# VITE_DOCS_URL=https://docs.example.com

# Public live demo (docs/demo.md): shows the "sandbox payments, data resets daily" banner.
# Set it together with DEMO_MODE=true in apps/api.
# VITE_DEMO_MODE=true
