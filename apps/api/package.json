{
  "name": "@beztack/api",
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "vercel-build": "pnpm build",
    "start": "node .output/server/index.mjs",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@beztack/auth": "workspace:*",
    "@beztack/db": "workspace:*",
    "@beztack/email": "workspace:*",
    "@beztack/env": "workspace:*",
    "@beztack/mercadopago": "workspace:*",
    "@beztack/payments": "workspace:*",
    "@beztack/payments-polar": "workspace:*",
    "@types/react": "^19.2.7",
    "better-auth": "~1.5.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "mercadopago": "^2.11.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "ui": "^0.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "h3": "^1.15.4",
    "nitropack": "^2.12.9",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.typecheck.json",
          "cwd": "apps/api"
        },
        "dependsOn": [
          {
            "projects": [
              "@beztack/auth"
            ],
            "target": "build"
          },
          {
            "projects": [
              "@beztack/env"
            ],
            "target": "build"
          },
          {
            "projects": [
              "@beztack/payments"
            ],
            "target": "build"
          },
          {
            "projects": [
              "@beztack/mercadopago"
            ],
            "target": "build"
          },
          {
            "projects": [
              "@beztack/payments-polar"
            ],
            "target": "build"
          }
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vp test run",
          "cwd": "apps/api"
        }
      }
    }
  }
}
