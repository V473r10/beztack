DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

BETTER_AUTH_SECRET=your_better_auth_secret_here
# For local development without external services:
BETTER_AUTH_URL=http://localhost:3000
# For development with Mercado Pago (use Tailscale hostname):
# BETTER_AUTH_URL=https://msi.tail26549e.ts.net:3000
VITE_API_URL=http://localhost:3000

# Extra browser origins allowed by API CORS, comma-separated. The origin of
# APP_URL is always allowed, so this only needs other domains (e.g. a custom
# domain next to the Vercel one).
CORS_ORIGINS=

# Scheduled ("cron") routes: each job reads its own <NAME>_CRON_SECRET through
# requireCronSecret. Unset disables that job (503). When set, it must be at
# least 32 characters (e.g. `openssl rand -hex 32`). Example:
# CLEANUP_CRON_SECRET=

POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here
POLAR_WEBHOOK_SECRET=whsec_your_webhook_secret_here
POLAR_SERVER=sandbox

# Product IDs from your Polar sandbox (replace with your actual product IDs)
POLAR_BASIC_MONTHLY_PRODUCT_ID=00000000-0000-0000-0000-000000000001
POLAR_BASIC_YEARLY_PRODUCT_ID=00000000-0000-0000-0000-000000000002
POLAR_PRO_MONTHLY_PRODUCT_ID=00000000-0000-0000-0000-000000000003
POLAR_PRO_YEARLY_PRODUCT_ID=00000000-0000-0000-0000-000000000004
POLAR_ULTIMATE_MONTHLY_PRODUCT_ID=00000000-0000-0000-0000-000000000005
POLAR_ULTIMATE_YEARLY_PRODUCT_ID=00000000-0000-0000-0000-000000000006

# Payment redirect URLs (provider-neutral, recommended)
PAYMENTS_SUCCESS_URL=http://localhost:5173/checkout-success
PAYMENTS_CANCEL_URL=http://localhost:5173/pricing

# Legacy aliases (kept for backward compatibility)
POLAR_SUCCESS_URL=http://localhost:5173/checkout-success
POLAR_CANCEL_URL=http://localhost:5173/pricing
POLAR_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

RESEND_FROM_NAME=Your Name
RESEND_FROM_EMAIL=email@example.com
RESEND_API_KEY=re_your_resend_api_key_here

# Payment Provider Selection (polar or mercadopago)
PAYMENT_PROVIDER=polar

# Mercado Pago (required if PAYMENT_PROVIDER=mercadopago)
MERCADO_PAGO_ACCESS_TOKEN=TEST-your_mercadopago_access_token_here
MERCADO_PAGO_APPLICATION_ID=123456789
MERCADO_PAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here
# Integrator ID for partner metrics tracking (optional)
MERCADO_PAGO_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004

APP_URL=http://localhost:5173

# Project regional defaults (required, no code default).
# The `create` CLI asks for these and writes them here.
# DEFAULT_CURRENCY: ISO 4217 code (e.g. USD). DEFAULT_LOCALE: BCP 47 tag (e.g. en-US).
# A price or Payment that carries its own currency always wins over DEFAULT_CURRENCY.
DEFAULT_CURRENCY=
DEFAULT_LOCALE=
