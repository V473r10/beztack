DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

BETTER_AUTH_SECRET=my-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app
VITE_API_URL=http://localhost:3000
APP_NAME=beztack

# Extra browser origins allowed by API CORS, comma-separated. The origin of
# APP_URL is always allowed, so this only needs other domains (e.g. a custom
# domain next to the Vercel one).
CORS_ORIGINS=

# Scheduled ("cron") routes: each job reads its own <NAME>_CRON_SECRET through
# requireCronSecret. Unset disables that job (503). When set, it must be at
# least 32 characters (e.g. `openssl rand -hex 32`). Example:
# CLEANUP_CRON_SECRET=

POLAR_ACCESS_TOKEN=polar_oat_*******************************************
POLAR_WEBHOOK_SECRET=whsec_your_webhook_secret_here
POLAR_SERVER=sandbox

# Product IDs from your Polar sandbox (replace with your actual product IDs)
POLAR_BASIC_MONTHLY_PRODUCT_ID=********-****-****-****-************
POLAR_BASIC_YEARLY_PRODUCT_ID=********-****-****-****-************
POLAR_PRO_MONTHLY_PRODUCT_ID=********-****-****-****-************
POLAR_PRO_YEARLY_PRODUCT_ID=********-****-****-****-************
POLAR_ULTIMATE_MONTHLY_PRODUCT_ID=********-****-****-****-************
POLAR_ULTIMATE_YEARLY_PRODUCT_ID=********-****-****-****-************

# Checkout URLs
PAYMENTS_SUCCESS_URL=http://localhost:5173/checkout-success
PAYMENTS_CANCEL_URL=http://localhost:5173/pricing
POLAR_SUCCESS_URL=http://localhost:5173/checkout-success
POLAR_CANCEL_URL=http://localhost:5173/pricing
POLAR_ORGANIZATION_ID=********-****-****-****-************

RESEND_FROM_NAME=Facundo
RESEND_FROM_EMAIL=email@facundovalerio.com
RESEND_API_KEY=re_********_************************

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-***********************
MERCADO_PAGO_APPLICATION_ID=123456789
MERCADO_PAGO_PUBLIC_KEY=APP_USR-***********************
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret_here

# Provider selection
PAYMENT_PROVIDER=polar
VITE_PAYMENT_PROVIDER=polar
